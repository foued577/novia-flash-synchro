# ---------------------------------------------------------------
# NOVIA Flash Synchro — variables d'environnement
# Copiez ce fichier en `.env.local` puis renseignez vos valeurs.
# ---------------------------------------------------------------

# Mode de données :
#   demo      → données de démonstration stockées dans le navigateur (aucun serveur requis)
#   supabase  → base Supabase (nécessite les deux variables ci-dessous)
VITE_DATA_MODE=demo

# Projet Supabase (Settings → API)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Routage : "browser" (URLs propres, nécessite la réécriture SPA) ou "hash" (#/…)
VITE_ROUTER=browser
